# Complete environment for the voice agent.
#
#   cp deploy/agent.env.example agent.env    # then fill in and chmod 600
#
# Everything the process reads from the environment is here. Anything NOT here
# lives in config.yaml instead — the split is deliberate: secrets and
# per-deployment addresses are environment, behaviour and tuning are config, so
# a config file can be committed and this file never can.
#
# The start scripts source ./rexa-secrets.env and ./telnyx.env, so either keep
# those two files or point them at this one:
#
#   SECRETS=./agent.env TELNYX_ENV=./agent.env bash deploy/scripts/contract-start.sh

# ─────────────────────────────────────────────────────────────────────
# Platform contract  — REQUIRED for the /connection, /incoming, /health
#                      endpoints to be registered at all
# ─────────────────────────────────────────────────────────────────────

# Shared with the platform, one secret per direction. The platform's own names
# for these are BACKUP_AGENT_OUTBOUND_HMAC_SECRET and
# BACKUP_AGENT_INBOUND_HMAC_SECRET.
#
# BOTH or NEITHER. With only one the agent would either verify dispatches but
# never report, or report but accept unauthenticated calls — so it refuses to
# enable the contract at all and logs why. An agent that accepts calls it
# cannot report on is worse than one that does not start.
#
# Used as raw UTF-8, never hex-decoded, despite being 64 hex characters.
REXA_OUTBOUND_HMAC_SECRET=   # platform signs dispatches with this; we verify
REXA_INBOUND_HMAC_SECRET=    # we sign callbacks with this; the platform verifies

# ─────────────────────────────────────────────────────────────────────
# Public address — REQUIRED for any real call
# ─────────────────────────────────────────────────────────────────────

# Where the CARRIER and the BROWSER reach us. Must be https:// — the media
# stream URL is derived from it, so plain http gives Telnyx a ws:// endpoint
# where it expects wss://, and browsers refuse a microphone on a non-secure
# origin.
#
# NOT the same as the address the platform dispatches to. contract-start.sh
# sets this to the tunnel it creates and leaves the platform pointed at the
# box's IP, because the tunnel hostname changes on every restart and the IP
# does not.
TELNYX_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────────
# Telephony — needed for the DEMO page to place calls
#
# Platform-dispatched calls do NOT use these: every dispatch carries the
# tenant's own credentials, and using a process-wide key would place one
# tenant's call on another tenant's carrier account.
# ─────────────────────────────────────────────────────────────────────

TELNYX_API_KEY=
TELNYX_APP_ID=              # the Call Control Application / connection id
TELNYX_FROM_NUMBER=         # E.164, e.g. +18483010124

# ─────────────────────────────────────────────────────────────────────
# Browser calls and live listening — OPTIONAL
# ─────────────────────────────────────────────────────────────────────

# Enables /connection_webrtc (browser calls) and the live-listening rooms that
# dispatches carrying redis details get. OUR account is billed, not the
# tenant's, which is why this is agent config and not a dispatch field.
# Without it both features are off and everything else is unaffected.
DAILY_API_KEY=

# The Python process that joins a Daily room on the agent's behalf, because
# Daily has no Go SDK. deploy/scripts/sidecar-install.sh creates the venv;
# contract-start.sh sets both of these automatically, so they are only needed
# when starting the server by hand.
SIDECAR_PYTHON=             # e.g. $HOME/sidecar-venv/bin/python
SIDECAR_SCRIPT=             # e.g. /path/to/repo/deploy/sidecar/room_agent.py

# ─────────────────────────────────────────────────────────────────────
# Live call events in Redis — OPTIONAL
# ─────────────────────────────────────────────────────────────────────

# Used only when a dispatch names a Redis host but carries no password, which
# is the case today because the platform's dispatch schema has no
# redis_password field. Managed Redis (Render Key Value, Upstash, ElastiCache
# with auth) refuses unauthenticated connections.
#
# A per-dispatch password always wins. The agent also works out the auth mode
# by itself on its first push — an open server that rejects AUTH makes it drop
# the credential and replay — so this is a convenience, not a requirement.
REXA_REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# Voices — OPTIONAL
# ─────────────────────────────────────────────────────────────────────

# Maps the platform's voice vocabulary onto kokoro speaker ids. An unmapped
# voice does not fail the call: it falls back to the configured default and
# logs once.
REXA_VOICE_MAP=             # e.g. leah=3,marcus=16,F2=21

# ─────────────────────────────────────────────────────────────────────
# Overrides — OPTIONAL
#
# Every config.yaml key is settable as ACHATBOT_<SECTION>_<KEY>. These are the
# ones worth setting per deployment rather than per repo.
# ─────────────────────────────────────────────────────────────────────

# ACHATBOT_SERVER_ADDR=":4399"
# ACHATBOT_SERVER_MAX_GPU_CALLS=61      # measured ceiling, not a guess
# ACHATBOT_SERVER_MAX_TOTAL_CALLS=200
# ACHATBOT_VAD_POOL_SIZE=64
# ACHATBOT_ASR_POOL_SIZE=64
# ACHATBOT_TTS_POOL_SIZE=64
# OPENAI_API_KEY=                       # only for a hosted LLM; empty for SGLang
