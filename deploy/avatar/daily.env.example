# Daily API key for the video-avatar service (server-side only — never sent to the browser).
# Create a key at https://dashboard.daily.co/developers, then:
#   cp daily.env.example ~/SoulX-FlashHead/daily.env && chmod 600 ~/SoulX-FlashHead/daily.env
#
# The service uses this to create a room and mint short-lived viewer tokens.
DAILY_API_KEY=your_daily_api_key_here
