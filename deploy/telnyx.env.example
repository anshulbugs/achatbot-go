# Telephony credentials (optional). Copy to ./telnyx.env at the repo root.
# Without this file the server still runs — only the phone-call demo is disabled;
# the browser-call demo works regardless.
#
# Get these from the Telnyx portal (https://portal.telnyx.com):
#   - API key:        Auth -> API Keys
#   - App (Connection) ID: Voice -> Call Control / Voice API Applications
#   - From number:    a number on your account, E.164 format
#
# The server reads TELNYX_PUBLIC_URL from tunnel-url.txt at startup; you do not
# set it here.

TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_APP_ID=0000000000000000000
TELNYX_FROM_NUMBER=+15551234567
