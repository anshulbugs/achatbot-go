# Voice-agent server config. Copy to ./config.yaml at the repo root and edit.
# The server is started with:  ./server-bin -config config.yaml

server:
  addr: ":4321"              # HTTP + WebSocket listen address
  max_conns: 1000            # rate-limiter max concurrent browser connections
  max_call_secs: 1200        # hard hangup after N seconds. REQUIRED for agent-to-agent
                             # load tests: two bots never hang up on each other. 0 disables.
  record_calls: false        # ask Telnyx to record every answered call (dual channel, mp3).
                             # Billed and stored by Telnyx — keep off for large runs.
  inbound_hello: ""          # greeting spoken when the agent answers an inbound call
  # Answering-machine detection on outbound calls. THIS KEY WAS PREVIOUSLY ABSENT,
  # which left it "" -> "disabled" on every dial, so no call.machine.* webhook could
  # ever fire and the voicemail path was dead code. Do not remove it again.
  #   disabled | detect | detect_beep | detect_words | greeting_end | premium
  # premium is Telnyx's recommended mode and the only one that distinguishes
  # silence and fax_detected from a plain machine; check its billing rate before
  # a large campaign, since it is priced separately from standard detection.
  voicemail_detection: premium
  # Spoken into the voicemail via the pre-rendered announcement (no GPU slot).
  # Empty means hang up as soon as a machine is detected.
  voicemail_message: ""
  # Concurrency ceiling for platform-dispatched calls. Past this many calls
  # holding a pipeline, /connection is refused with at_capacity and /health
  # reports accepting=false. Calls playing a voicemail announcement do NOT
  # count -- they hold no pool slots.
  #
  # 61 is MEASURED, not a guess: 60 concurrent agent sessions held p95 at
  # 1628ms with zero dropped audio writes, while 100 gave 6244ms and 234
  # drops. It is specific to this model, prompt size and GPU layout --
  # remeasure with deploy/loadtest when any of those change. 0 = unlimited.
  max_gpu_calls: 61
  # Absolute in-flight ceiling, counting calls that cost no GPU at all. Stands
  # in for what our counters cannot see: the carrier's concurrent channel cap,
  # CPU for hundreds of media streams, TTS renders at dispatch time. No
  # capacity estimate may argue past it. 0 = unlimited.
  #
  # In practice max_gpu_calls binds first and this never fires -- projected
  # steady state at 90% voicemail is ~126 calls in flight at weight 1.0, and
  # ~188 at weight 0.3. 200 sits just above that, so it is a real backstop
  # rather than decoration. Raise it together with a lower human_answer_weight,
  # and watch the box: CPU was 5-6 cores at 60 agents, and several hundred
  # concurrent media streams is untested territory.
  max_total_calls: 200
  # Expected GPU cost of one dispatched call -- the fraction that reach a live
  # pipeline rather than an answering machine, a no-answer or a busy.
  # Accepts a number, or the word "auto".
  #
  # The rule is: weight >= the real answer rate. Admission lets
  # (max_gpu_calls / weight) calls ring at once, and whatever fraction of them
  # answers becomes pipelines -- so a weight below the true rate creates more
  # pipelines than the ceiling allows, and a call a human has already picked
  # up cannot be refused.
  #
  #   1.0    charge every dispatch a full slot. The ONLY value that guarantees
  #          on_gpu never exceeds max_gpu_calls. Under-utilises when most calls
  #          reach voicemail. Use this for a first real campaign.
  #   auto   track the measured answer rate x a 2x safety margin, floored at
  #          0.15 and capped at 1.0. Starts at 1.0 until enough calls resolve.
  #          The margin covers batches that answer better than recent average;
  #          the mean alone would overshoot on roughly half of them.
  #   0.3    a fixed over-subscription, once the rate is known and steady.
  #
  # Read measured.answer_rate off /dashboard before moving off 1.0.
  human_answer_weight: 1.0
  # Latency backpressure on the FIRST turn of each call -- the pause the caller
  # hears after saying hello. Tracked apart from every other turn because it is
  # the only one that pays a cold prefill, so KV-cache pressure shows up here
  # first and largest. Measured at 60 concurrent calls with 3k-token prompts:
  #
  #                          one campaign   a different prompt per call
  #   p95 across all turns       1725 ms             6252 ms
  #   p95 of TURN 1              1853 ms             9903 ms
  #
  # The pooled number is what a naive threshold watches, and it would have let
  # those calls through. These two can turn accepting=false with the GPU ceiling
  # nowhere near reached, which is the point: max_gpu_calls 61 was measured
  # under one prompt size and one degree of prefix sharing, and a heavier
  # workload invalidates it. Serving 6 calls well beats accepting 61 and serving
  # all of them badly.
  #
  # CALIBRATED against a ramp, not guessed. At 60 calls through two replicas:
  #   one campaign, contact block last      2286 ms   must not trip
  #   12 independent campaigns              3550 ms   must not trip
  #   30 independent campaigns              5400 ms   should trip
  #   60 unique prompts, varying part first 5906 ms   must trip
  # saturated sits in the gap. Remeasure with deploy/loadtest/calibrate.sh
  # whenever prompt size, model or replica count changes. 0 = built-in default.
  first_turn_saturated_ms: 4500   # p95 over >=4 calls that shuts admission
  first_turn_critical_ms: 7000    # ONE first turn this slow shuts it immediately
  first_turn_cooldown_secs: 30    # then reopen and re-measure on fresh calls
  # SGLang base URLs (not the /v1 path) whose /metrics is polled every 5s for
  # prefix-cache hit rate and queue depth. Shown on /dashboard and /health;
  # nothing here refuses traffic. Empty disables it.
  sglang_metrics_urls: []
  # Mid-call sentiment classification. Empty base_url disables it entirely,
  # whatever a dispatch asks for.
  #
  # Point this at a SMALL model on its OWN endpoint, never at the conversation
  # LLM. First-turn latency on that model is what decides how many calls the
  # fleet can carry (see first_turn_* above), and classifying on it spends the
  # exact resource capacity is measured in. A 0.6B model on Ollama costs
  # nothing the caller waits for and nothing the capacity gate counts.
  sentiment_base_url: ""          # e.g. "http://127.0.0.1:11434/v1"
  sentiment_model: "qwen3:0.6b"
  # sglang_metrics_urls: ["http://127.0.0.1:8001", "http://127.0.0.1:8002"]
  chat_history_size: 6       # turns of context kept per conversation
  allow_interruptions: true  # barge-in
  # The greeting/first message is spoken directly via TTS and never sent to the
  # LLM (zero first-response delay). This prompt drives the *conversation*.
  # A full conversational prompt lives in deploy/prompts/conversational_agent.txt.
  # Prompt length is nearly free: measured warm TTFT was 30ms at 218 words, 35ms at 1352,
  # and 87ms at 17k words. What long prompts cost is concurrency, not latency, since each
  # call's prompt sits in the KV cache: ~60 agents at 1.5k words, ~25 at 10k.
  system_prompt: "You are a warm, natural voice assistant on a phone call. Speak like a real person in full, complete thoughts, usually two to four sentences. The caller's words come from speech recognition and may contain small errors, so infer intent from context and never mention transcription. No emoji or special characters, since your reply is read aloud."
  idle_prompt_secs: 6                    # re-prompt after this many seconds of silence
  idle_prompt_text: "Are you still there?"
  first_chunk_words: 0                   # 0 = synthesize whole sentences (smoothest);
                                         # >0 = flush an opening chunk of N words first
                                         # (lower first-audio latency, only helps on slow TTS)
  turn_gate_enabled: false               # experimental semantic endpointing (leave off)
  turn_gate_model: "llama3.2:3b"
  turn_gate_max_wait_secs: 2.5

vad:
  model: silero              # runs on CPU; one instance per concurrent call
  pool_size: 64              # >= expected max concurrent calls (raise for load tests)
  stop_secs: 0.6             # silence before a turn ends. This is the single biggest
                             # contributor to measured turn latency: latency is timed from the
                             # caller's last speech, so stop_secs is paid on every turn.
                             # 0.5 chops mid-sentence pauses, 0.8 costs ~200ms more per turn.

asr:
  model: parakeet_http       # GPU Parakeet via deploy/asr (see also: sense_voice for CPU)
  http_url: "http://127.0.0.1:8890"
  pool_size: 64
  num_threads: 8             # only used by the CPU sherpa models
  language: en

tts:
  model: kokoro_http         # GPU Kokoro via deploy/tts (see also: kokoro for CPU)
  http_url: "http://127.0.0.1:8880"
  speaker_id: 3              # 3 = Heart (US female). See UI voice list for ids.
  speed: 1.2                 # 1.0 = normal
  gain: 1.4                  # output loudness multiplier (per-call overridable)
  pool_size: 64
  num_threads: 12            # only used by the CPU sherpa model

llm:
  provider: openai_api                   # OpenAI-compatible (SGLang / vLLM / Ollama)
  base_url: "http://127.0.0.1:8001/v1"   # SGLang endpoint
  model: "RedHatAI/Qwen2.5-7B-Instruct-FP8-dynamic"
  stream: true
  tools: []
