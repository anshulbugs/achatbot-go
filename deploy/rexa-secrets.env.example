# Secrets for the platform-contract instance (deploy/scripts/contract-start.sh).
#
# Copy to ./rexa-secrets.env at the repo root and fill in. Keep it 0600 — it
# holds the two shared HMAC secrets and the Daily key, and the start script
# sources it rather than passing them on the command line so they do not sit in
# `ps` output for every user on a shared box.

# Shared with the platform, one per direction. BOTH are required: with only one
# the agent would either verify dispatches but never report, or report but
# accept unauthenticated calls, so it refuses to enable the contract at all.
# The platform calls these BACKUP_AGENT_OUTBOUND_HMAC_SECRET and
# BACKUP_AGENT_INBOUND_HMAC_SECRET.
REXA_OUTBOUND_HMAC_SECRET=   # platform signs dispatches with this; we verify
REXA_INBOUND_HMAC_SECRET=    # we sign callbacks with this; the platform verifies

# Our externally reachable base URL. contract-start.sh overwrites this with the
# tunnel it creates, so it only matters if you start the server by hand.
AGENT_BASE_URL=

# Optional. Enables live-listening rooms and browser (WebRTC) calls. Ours to
# bill, not a tenant's, which is why it is agent config and not a dispatch
# field. Without it both features are simply off.
DAILY_API_KEY=

# Optional. Used only when a dispatch names a Redis host but carries no
# password — managed Redis refuses unauthenticated connections. A per-dispatch
# password always wins. The agent works out which mode the server wants on its
# first push, so this is a convenience, not a requirement.
REXA_REDIS_PASSWORD=
